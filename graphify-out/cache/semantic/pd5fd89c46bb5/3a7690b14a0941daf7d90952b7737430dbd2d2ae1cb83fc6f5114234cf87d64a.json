{"nodes": [{"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_doc", "label": "\ud50c\ub808\uc774\uc5b4 \uce90\ub9ad\ud130 \ubc0f \uce74\ub4dc\ud480 \uc124\uacc4 \uaddc\uce59", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_port_structure", "label": "\ud3ec\ud2b8 \uae30\ubc18 \uce90\ub9ad\ud130 \uad6c\uc870 (\u25ce \u2191 \u2193 \u21c4)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a72, \u00a72.1, \u00a72.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud30c\ud2f0\uc6d0\uc774 \ub298\uc218\ub85d \uc6d0\ud558\ub294 \uce74\ub4dc\uac00 \ud568\uaed8 \uc7a1\ud790 \ud655\ub960\uc740 \ub0ae\uc544\uc9c0\uace0 \uc6b4\uba85\ub825 \uacbd\uc7c1\uc740 \ub298\uba70, \uc0ac\ub9dd\uc73c\ub85c \uc18c\uc720 \uce74\ub4dc\uac00 \uc81c\uac70\ub418\uba74 \ud2b9\uc815 \ud30c\ud2f0\uc6d0 \uc804\uc6a9 \uce74\ub4dc\ub294 \uac11\uc790\uae30 \ubb34\ud6a8\uac00 \ub41c\ub2e4. \uc870\uac74\ubd80 \uce74\ub4dc\ub97c \uae08\uc9c0\ud558\ub294 \ub300\uc2e0 \ubc94\uc6a9 \uc804\ud22c \uae30\ubc18\uc744 \ub3c5\ub9bd \uc720\uc9c0\ud558\uace0 \uacf5\uc6a9 \uc2e0\ud638\uc758 \uacf5\uae09 \ud3ed\uc744 \uad00\ub9ac\ud55c\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_character_contract", "label": "\uce90\ub9ad\ud130 \uacc4\uc57d\uc11c (\uc815\uccb4\uc131 = \uc815\ud655\ud788 2\uac1c \ud575\uc2ec \ucee8\uc149)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a72.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uce90\ub9ad\ud130 \ud558\ub098\uac00 \uc2dc\ub108\uc9c0\uc758 \uc0dd\uc131\u00b7\uc99d\ud3ed\u00b7\uc18c\ube44\ub97c \uc804\ubd80 \uc644\uc131\ud558\uc9c0 \uc54a\ub3c4\ub85d \ub0b4\ubd80 \uc644\uacb0 \uae08\uc9c0 \ud56d\ubaa9\uc744 \uacc4\uc57d\uc11c\uc5d0 \uba85\uc2dc\ud55c\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_card_pool_composition", "label": "\uce74\ub4dc\ud480 \uad6c\uc131 \uae30\uc900 (18~24\uc7a5)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a72.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_card_differentiation", "label": "\uce74\ub4dc \ucc28\ubcc4\ud654 \uaddc\uce59 (\uc0c1\uc704\u00b7\ud558\uc704\ud638\ud658 \uae08\uc9c0)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a72.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc720\uc0ac\uc131\uc774 \ud5c8\uc6a9\ub418\ub294 \uce74\ub4dc\ub294 \uae30\ubcf8 \uacf5\uaca9\u00b7\uae30\ubcf8 \ubc29\uc5b4\ubfd0\uc774\uba70, \uadf8\ub9c8\uc800\ub3c4 \ud55c \uce74\ub4dc\uac00 \uc720\ub9ac\ud558\uba74 \ubc18\ub4dc\uc2dc \ubd88\ub9ac\ud55c \uc810\ub3c4 \uc788\uc5b4\uc57c \ud55c\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_universal_core_roles", "label": "\ubc94\uc6a9 \uce74\ub4dc \u00b7 \ud575\uc2ec \uce74\ub4dc \uc124\uacc4 \uc5ed\ud560", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a72.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ubc94\uc6a9\uc740 \uacf5\uc6a9 \uc18c\uc720\uad8c\uc774 \uc544\ub2c8\ub77c \uac19\uc740 \uc0c1\uc704 \uc544\ud0a4\ud0c0\uc785\uc758 \ub458 \uc774\uc0c1 \ud558\uc704 \ub371\uc5d0\uc11c \uc758\ubbf8 \uc788\uac8c \uc4f0\uc778\ub2e4\ub294 \uc800\uc791 \uc758\ub3c4\ub2e4. \ubc94\uc6a9\uc131\uc774 \uc720\uc0ac \uce74\ub4dc\ub97c \uc5ec\ub7ec \uc7a5 \ub9cc\ub4dc\ub294 \uadfc\uac70\uac00 \ub420 \uc218 \uc5c6\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_condition_supply_breadth", "label": "\uc870\uac74\ubd80 \uce74\ub4dc\uc758 \uacf5\uc6a9 \uacf5\uae09 \ud3ed \uac80\uc218", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a72.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc870\uac74 \uc2e4\ud328 \uc2dc \uae30\ubcf8 \ud6a8\uacfc\ub97c \uac15\uc81c\ud558\uc9c0 \uc54a\ub294 \ub300\uc2e0 \uc870\uac74\uc774 \uc694\uad6c\ud558\ub294 \uacf5\uc6a9 \uc0c1\ud0dc\u00b7\uc0ac\uac74\uc744 \uc5ec\ub7ec \uce90\ub9ad\ud130\uc758 \uce74\ub4dc\uac00 \uacf5\uae09\ud558\ub294\uc9c0 \uac80\uc218\ud55c\ub2e4. \ud2b9\uc815 \uce90\ub9ad\ud130\u00b7\uce74\ub4dc \uc774\ub984\uc744 \uc694\uad6c\ud558\ub294 \uc870\uac74\uc740 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_card_lifetime_source", "label": "\uce74\ub4dc \uc218\uba85\u00b7\ucd9c\ucc98 \ucd95 (\uc77c\ubc18 / \ud761\uc218 / \ud1a0\ud070)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a72.10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uce74\ub4dc \uc5ed\ud560(\uc2e4\ud589/\uc870\uc791)\uacfc \uc218\uba85\u00b7\ucd9c\ucc98\ub294 \uc11c\ub85c \ub3c5\ub9bd\ub41c \ub450 \ucd95\uc774\ub2e4. '\uc18c\uba78.'\uc740 \uc218\uba85 \uac12\uc774 \uc544\ub2c8\ub77c \uc0ac\uc6a9 \ud69f\uc218\uc640 \uc0ac\uc6a9 \ud6c4 \uc774\ub3d9\uc744 \ubc14\uafb8\ub294 \ud6a8\uacfc \ud0a4\uc6cc\ub4dc\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_block_keyword", "label": "\ubc29\uc5b4 \ud0a4\uc6cc\ub4dc (\ud569\uc0b0)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc5ec\ub7ec \ubc29\uc5b4 \ubd80\uc5ec\ub294 2026-07-29 \ud655\uc815\uc73c\ub85c \ud569\uc0b0\ud558\uba70, \ub3c5\uc758 \uc218\uce58 \ub204\uc801\uacfc \uac19\uc740 \ud569\uc0b0 \uaddc\uce59\uc744 \uacf5\uc720\ud574 \ucf54\uc5b4\uc5d0\uc11c\ub294 \uc0c1\ud0dc \ud589\ub3d9\uc758 StacksMagnitude \uc120\uc5b8\uc73c\ub85c \ud45c\ud604\ud55c\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_poison_keyword", "label": "\ub3c5 X \ud0a4\uc6cc\ub4dc", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ub3c5\uc740 \uc81c\uac70 \ud6a8\uacfc\uac00 \uc5c6\uc73c\uba74 \uc2a4\uc2a4\ub85c \uc99d\uac00\ud558\ubbc0\ub85c \ub2e8\uc21c\ud788 \ub3c5 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud558\ub294 \uac83\ub9cc\uc73c\ub85c\ub294 \ub3c5\ub9bd \uc544\ud0a4\ud0c0\uc785\uc774 \ub418\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_poison_priority", "label": "\ub3c5 \ud6a8\uacfc \uc6b0\uc120\uc21c\uc704 5\uce35 (\uae08\uc9c0\u00b7\ub300\uccb4\u00b7\ubc30\uc728\u00b7\uac00\uac10\u00b7\uae30\ubcf8)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc11c\ub85c \ubaa8\uc21c\ub418\ub294 \ub3c5 \ud6a8\uacfc\ub97c \uae08\uc9c0\ud558\ub294 \ub300\uc2e0 \uce35 \uc6b0\uc120\uc21c\uc704\ub85c \uacb0\uacfc\ub97c \uacb0\uc815\ud55c\ub2e4. \uac19\uc740 \uce35\uc758 \uc0c1\ucda9\ud558\ub294 \ub300\uccb4 \ud6a8\uacfc\ub294 \ub098\uc911 \uc801\uc6a9\uc774 \uc6b0\uc120\ud558\uace0 \uac00\uac10\uc740 \ud569\uc0b0\ud558\uba70, \ubc30\uc728\uacfc \ubc18\uc62c\ub9bc \uc21c\uc11c\ub294 \uad6c\ud604 \uc804\uc5d0 \ud558\ub098\uc758 \uacb0\uc815\ub860\uc801 \uaddc\uce59\uc73c\ub85c \uace0\uc815\ud55c\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_poison_archetypes", "label": "\ub3c5 \uce74\ub4dc\ud480 \uc138 \uc544\ud0a4\ud0c0\uc785 (\uc131\uc7a5\ud615\u00b7\uc18c\ube44\ud615\u00b7\ubcc0\uc774\ud615)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a73.4, \u00a73.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ucd09\uc9c4\u00b7\ubc1c\ub3d9 \uc870\uc808\u00b7\ub3c5 \uc774\uc804 \uac19\uc740 \uae30\ub2a5\uc740 \ub3c5\ub9bd \uc544\ud0a4\ud0c0\uc785\uc73c\ub85c \ub298\ub9ac\uc9c0 \uc54a\uace0 \uc138 \ucd95\uc758 \ubcf4\uc870 \ud328\ud0a4\uc9c0\ub85c \ubc30\uce58\ud55c\ub2e4. \uc548\uc815\uc801 \uacf5\uae09 \ucc45\uc784\uc740 \uc131\uc7a5\ud615\uc5d0 \ub450\uace0, \ud070 \uc544\ud0a4\ud0c0\uc785\uc740 4~6\uba85\uc758 \uce90\ub9ad\ud130\uac00 \uc11c\ub85c \ub2e4\ub978 \ubc29\uc2dd\uc73c\ub85c \uae30\uc5ec\ud560 \uc218 \uc788\uac8c \uc124\uacc4\ud55c\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_20_character_card_pools_design_legacy_acquisition", "label": "\uc720\uc0b0 \ud0d0\uc0c9\uacfc \uacc4\uc2b9\uc790 \uaddc\uce59", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-20-character-card-pools-design.md", "source_location": "\u00a74.2, \u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc6d0\ud558\ub294 \uce74\ub4dc\ub97c \uc9c0\uc815\ud558\ub294 \uad6c\ub9e4\uac00 \uc544\ub2c8\ub77c \ube44\uc6a9\uc744 \uc9c0\ubd88\ud574 \ube44\ubcf5\uc6d0 \ucd94\ucd9c\ud558\ub294 \uc808\ucc28\ub2e4. \uacf5\uac1c\ub41c \ud6c4\ubcf4\ub294 \uc774\ud6c4 \uc81c\uc678\