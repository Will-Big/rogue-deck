{"nodes": [{"id": "docs_superpowers_specs_2026_07_15_party_foundation_design_doc", "label": "\ud30c\ud2f0 \uae30\ubc18 \uc804\ud22c \ud655\uc7a5 \uc124\uacc4", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-15-party-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_15_party_foundation_design_party_structure", "label": "\ucd5c\ub300 3\uc778 \ud30c\ud2f0 \u00b7 \ub85c\uc2a4\ud130 \uc5c6\uc74c", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-15-party-foundation-design.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ubcf4\uc720 = \uc804\uc6d0 \ucd9c\uc804\uc774\uba70 \ubca4\uce58 \uac1c\ub150\uc774 \uc5c6\ub2e4. \uce90\ub9ad\ud130\uac00 \uace7 \uce74\ub4dc \ud480\uc774\ubbc0\ub85c \uc2dc\ub108\uc9c0 \uce90\ub9ad\ud130\ub97c \ud30c\ud2f0\uc5d0 \ud3ec\ud568\uc2dc\ud0a4\ub294 \uac83\uc774 \ub371 \ube4c\ub529\uc774\ub2e4. 07-14 \uc778\uc218\uc778\uacc4\uc758 \ub85c\uc2a4\ud130\u00b7\uc7a5\ucc29\uc81c \uc548\uc744 \ub4a4\uc9d1\uc740 \uacb0\uc815."}, {"id": "docs_superpowers_specs_2026_07_15_party_foundation_design_card_ownership", "label": "\uce74\ub4dc \uce90\ub9ad\ud130 \uadc0\uc18d (\uacf5\uc6a9 \uce74\ub4dc \uc5c6\uc74c)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-15-party-foundation-design.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ubaa8\ub4e0 \uce74\ub4dc\ub294 \uc815\ud655\ud788 \ud55c \uce90\ub9ad\ud130\uac00 \uc18c\uc720\ud558\uba70 \uc6b4\uba85 \uce74\ub4dc\ub3c4 \uadc0\uc18d\ub41c\ub2e4. '\ubc94\uc6a9'\uc740 \uc124\uacc4 \uc5ed\ud560\uc774\uc9c0 \uacf5\uc6a9 \uc18c\uc720\uad8c\uc774 \uc544\ub2c8\ub2e4. \uc8fd\uc74c\uc758 \uc190\uc2e4 \ud06c\uae30\ub97c \ud50c\ub808\uc774\uc5b4\uc758 \uadc0\uc18d \uc120\ud0dd\uc774 \uacb0\uc815\ud558\uac8c \ub9cc\ub4e0\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_15_party_foundation_design_party_economy", "label": "\ud30c\ud2f0 \uc778\uc6d0 \ube44\ub840 \ud61c\ud0dd (\ub4dc\ub85c\uc6b0\u00b7\uac1c\ubcc4 HP)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-15-party-foundation-design.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2\uc778 \uc774\ud558\uc5d0 \ubcf4\uc815\uc744 \uc8fc\uba74 \uc18c\uc218 \uc778\uc6d0 \uc720\uc9c0\uac00 \ucd5c\uc801\ud654 \ub300\uc0c1\uc774 \ub41c\ub2e4. \uc801\uc740 \uc778\uc6d0 = \uc587\uc740 \ud480 = \ub192\uc740 \uc555\ucd95\ub960\uc774\ub77c\ub294 \uc740\uadfc\ud55c \uc774\uc810\uc774 \uc774\ubbf8 \uc788\uc73c\ubbc0\ub85c \ub4dc\ub85c\uc6b0 \ube44\ub840 \uc2a4\ucf00\uc77c\ub85c\ub9cc \uc0c1\uc1c4\ud558\uace0 \ubcc4\ub3c4 \ud398\ub110\ud2f0\ub294 \ub450\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_15_party_foundation_design_death_rules", "label": "\uc8fd\uc74c \uaddc\uce59 (\uce58\uba85 \ubc84\ud300 \u00b7 \uce74\ub4dc \uc81c\uac70 \u00b7 \ubb34\ud6a8\ud654)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-15-party-foundation-design.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud1a4\uc740 Darkest Dungeon\uc774\ub418 \uc8fd\uc74c\uc774 '\uc313\uc544\uc628 \ub371 \ubd95\uad34 \u2192 \ub9ac\uc14b \ud2b8\ub9ac\uac70'\uac00 \ub418\uc5b4\uc11c\ub294 \uc548 \ub41c\ub2e4. \uce58\uba85 \ud53c\ud574 \uc2dc HP 1\ub85c 1\ud68c \ubc84\ud2f0\uace0, \uc0ac\ub9dd \uc2dc \ub371\u00b7\uc190\ud328 \uce74\ub4dc\ub294 \uc989\uc2dc \uc81c\uac70\ud558\ub418 \ubbf8\ub798 \uc601\uc5ed \uce74\ub4dc\ub294 \uae30\uc874 \uce74\ub4dc \uc2a4\ucf54\ud504 \ubb34\ud6a8\ud654 \uba54\ucee4\ub2c8\uc998\uc744 \uc7ac\uc0ac\uc6a9\ud55c\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_15_party_foundation_design_formation_targeting", "label": "\ub300\ud615(\ubc30\uce58 \uc21c\uc11c)\uacfc \uc704\uce58 \ubc94\uc704 \ud0c0\uac9f\ud305", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-15-party-foundation-design.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc9c1\uc811 \uc120\ud0dd\u00b7\ubb34\uc791\uc704 \uc120\ud0dd\u00b7\uc0c1\ud0dc \uc6b0\uc120 \uc120\ud0dd\uc740 \uc720\ub2db \ub300\uc0c1 \ubb38\ubc95\uc73c\ub85c \uc4f0\uc9c0 \uc54a\uace0 \uc55e/\ub4a4/\ubaa8\ub450\uc758 \uc704\uce58 \ubc94\uc704\ub9cc \uc4f4\ub2e4. \uc544\uad70\uacfc \uc801\uad70\uc740 \ub3c5\ub9bd\ub41c \uc704\uce58 \ubc94\uc704\ub97c \uac00\uc9c4\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_15_party_foundation_design_no_punish_principle", "label": "\uae30\ubcf8 \uaddc\uce59\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \ubc8c\ud558\uc9c0 \uc54a\ub294\ub2e4", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-15-party-foundation-design.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud50c\ub808\uc774\uc5b4\uac00 \ubd88\ucf8c\ud558\uc9c0 \uc54a\uac8c \ub290\ub07c\ub294 \uac83\uc774 \uacf5\uc815\uc131\ubcf4\ub2e4 \uc6b0\uc120\uc774\ub2e4. \uc555\ubc15\uc740 \uc801 \uc124\uacc4\uc5d0\uc11c\ub9cc \uc624\uace0 \uc720\ub3c4\ub294 \ubcf4\uc0c1\uc73c\ub85c\ub9cc \ud55c\ub2e4."}, {"id": "docs_superpowers_specs_2026_07_15_party_foundation_design_sts_similarity_open", "label": "\uc804\ud22c \ud134 \ub8e8\ud504\uc758 StS \uc720\uc0ac\uc131 (\ubbf8\ud574\uacb0)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-15-party-foundation-design.md", "source_location": "\u00a70, \u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'\uc190\ud328\uc5d0\uc11c \ubb58 \ub0bc\uc9c0 \uace0\ubbfc\ud558\ub294 \uc21c\uac04'\uc774 \uac00\uc7a5 StS \uac19\ub2e4\ub294