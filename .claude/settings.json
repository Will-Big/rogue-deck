{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(Tools/verify.sh:*)",
      "Bash(./Tools/verify.sh:*)",
      "Bash(Tools/graph/rebuild-graph.sh:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet --list-sdks)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(/usr/bin/grep:*)",
      "Bash(/usr/bin/find:*)",
      "Bash(/usr/bin/sed:*)",
      "Bash(pgrep:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main-branch-switch.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-core-on-stop.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
