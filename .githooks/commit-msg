#!/usr/bin/env bash
# 커밋 제목 검사 — 규칙 27. 어떤 도구로 커밋하든 걸린다.
#
# 활성화는 pre-commit과 같다: Tools/setup-dev.sh (git config core.hooksPath .githooks).
# 훅은 편의이지 강제가 아니다 — `--no-verify`로 건너뛸 수 있다. 진짜 게이트는 CI다.
#
# **근거 문장을 여기에 쓰지 않는다.** 막을 때는 Tools/rule-note.sh가 docs/agents/의 절을 잘라
# 배달한다. 문구를 복사하면 규칙 하나가 두 자리로 갈라지고, 규칙이 바뀔 때 한쪽만 낡는다.
# 여기 남기는 것은 **판정 결과**뿐이다 — 무엇이 막혔고 어떻게 재현·우회하는지.

set -uo pipefail

MSG_FILE="${1:-}"
SOURCE="${2:-}"   # git이 주는 커밋 소스: message·template·merge·squash·commit, 또는 빈 값
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# 검사할 트리는 **git에게 묻는다** — 이유는 .githooks/pre-commit 상단 주석과 같다.
# core.hooksPath가 상대 경로라 워크트리에서 커밋해도 메인 체크아웃의 훅 파일이 실행된다.
ROOT="$(git rev-parse --show-toplevel)"
GITDIR="$(git rev-parse --absolute-git-dir)"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
cd "$ROOT" || exit 0
# 이 저장소가 아니면 아무것도 하지 않는다. core.hooksPath는 절대 경로로도 설정될 수 있고
# (실측: 현재 이 머신은 /Users/ish/Git/rogue-deck/.githooks), 그러면 다른 저장소의 커밋까지
# 이 훅이 잡을 수 있다. 규칙 27은 이 저장소의 규칙이다.
[ -x Tools/rule-note.sh ] || exit 0

GREP=/usr/bin/grep   # bare grep이 셸 알리아스로 실패하는 환경이 있어 절대 경로를 쓴다

# 메시지를 git이 만드는 커밋은 통과시킨다. 사람이 쓴 제목이 아니므로 규칙 27의 대상이 아니다.
case "$SOURCE" in
  merge|squash) exit 0 ;;
esac
[ -e "$GITDIR/MERGE_HEAD" ] && exit 0

# 주석 줄(#)과 빈 줄을 건너뛴 첫 실제 줄이 제목이다.
SUBJECT="$(awk 'substr($0,1,1) == "#" { next } NF == 0 { next } { print; exit }' "$MSG_FILE")"
[ -n "$SUBJECT" ] || exit 0   # 빈 메시지는 git이 먼저 막는다

# 머지·리버트도 git이 제목을 만든다. 소스 인자가 비어 오는 경로가 있어 제목으로도 한 번 더 본다.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"Reapply "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# 규칙 27의 형식. 이 정규식의 사본은 docs/agents/commit-messages.md의 「훅이 검사하는 것」 절에도
# 있다 — 고칠 때 둘을 같은 커밋에서 고친다.
#
# 끝을 `다`로 본다. 규칙 27의 "…한다로 끝나는 현재형 평서문"은 종결어미 -ㄴ다를 말하는 것이지
# 「한다」라는 글자가 아니다. 글자 그대로 잡으면 `만든다`·`뒤집는다`·`붙인다`가 전부 막히고,
# 실측으로 최근 비머지 커밋 60건 중 23건(38%)이 걸렸다 — 규칙 27이 자기 예시로 든 두 줄까지
# 포함해서다. `[가-힣]` 요구가 남아 영어 제목은 여전히 막힌다.
SUBJECT_RE='^(feat|fix|docs|refactor|test|chore)(\([a-z]+\))?: .*[가-힣].*다\.?$'

printf '%s\n' "$SUBJECT" | "$GREP" -qE "$SUBJECT_RE" && exit 0

{
  echo "commit-msg: 규칙 27 위반 — 커밋 제목이 형식과 맞지 않는다."
  echo "  제목: $SUBJECT"
  echo "  형식: $SUBJECT_RE"
  echo "  재현: .githooks/commit-msg <메시지 파일>"
  echo "  건너뛰려면 --no-verify (CI가 다시 잡는다)"
  echo
  # 근거는 문서 하나에서만 온다. 절이 없으면 exit 1로 조용히 끝나고, 위 판정만 남는다.
  Tools/rule-note.sh 27
} >&2

exit 1
