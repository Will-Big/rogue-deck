<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless test harness for the pure-C# FateWeaver.Core.
    Compiles the SAME Core + EditMode test sources that Unity compiles, but runs via
    `dotnet test` (no Unity needed, editor can stay open).

    LangVersion 9 deliberately matches Unity 6's compiler, so any C# 10+ feature
    (e.g. record struct, file-scoped namespaces) or UnityEngine reference fails HERE
    too — making this a faithful proxy for Unity's compile constraints.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <!-- 설치된 런타임이 net6.0보다 높아도 그 런타임으로 실행한다. 이 머신에는 arm64용 6.0 런타임이
         없고(.NET 10만 있다) CI는 6.0으로 돈다 — 둘 다 같은 프로젝트로 돌리기 위한 설정이다. -->
    <RollForward>Major</RollForward>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Sources live outside this folder; disable the default ./**/*.cs glob. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure-C# core (no UnityEngine references) -->
    <Compile Include="../../Assets/Core/**/*.cs" Exclude="../../Assets/Core/Simulation/**/*.cs;../../Assets/Core/Tests/**/*.cs" />
    <!-- Pure-C# simulation layer -->
    <Compile Include="../../Assets/Core/Simulation/**/*.cs" />
    <!-- Shared EditMode test sources (must use only NUnit, no UnityEngine.TestTools) -->
    <Compile Include="../../Assets/Core/Tests/EditMode/**/*.cs" />
  </ItemGroup>

</Project>
